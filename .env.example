# Pulse environment. Copy to `.env` (gitignored) and fill in.
#
# THIS FILE HOLDS SECRETS ONLY — API keys, DB URL, signing key, bootstrap password.
# Everything else (dev knobs, worker/reconcile, token lifetimes, and the per-role LLM
# provider + model) lives in src/voiceobs/config.py — edit there, not here.
# All variables are VOICEOBS_-prefixed and read by voiceobs/config.py.

# ── Core secrets (required in a real deployment) ────────────────────────────────
# Signs session JWTs AND encrypts stored credentials (e.g. per-agent S3 secrets).
# Keep it stable and secret; rotating it logs everyone out and orphans encrypted creds.
VOICEOBS_SECRET_KEY=

# SQLite auto-enables dev mode; use Postgres in production.
VOICEOBS_DATABASE_URL=postgresql://user:pass@localhost:5432/pulse

# ── First-run owner (headless bootstrap: python -m voiceobs.auth bootstrap) ──────
VOICEOBS_BOOTSTRAP_PASSWORD=

# ── LLM API keys (one per role; provider + model are set in config.py) ───────────
# A role is active only when its key is set. Roles sharing a provider may reuse the
# same key value. Leave a role's key blank to disable it (judge skips / chat errors).
VOICEOBS_POST_CALL_API_KEY=
VOICEOBS_GLOBAL_CHAT_API_KEY=
VOICEOBS_PER_CALL_CHAT_API_KEY=
# Failure-analysis LLM — runs alongside the judge for root-cause analysis (leave blank to skip).
VOICEOBS_FAILURE_ANALYSIS_API_KEY=
# BYO embedding model for semantic clustering (OpenAI-compatible endpoint; model + endpoint in
# config.py: embedding_model / embedding_base_url / embedding_dim). Leave blank to skip clustering.
VOICEOBS_EMBEDDING_API_KEY=

# ── Optional overrides (defaults live in config.py; set here only to override) ───
# VOICEOBS_DEV_OPEN=1                 # dev conveniences (prefilled login, token-less ingest). NEVER in prod.
# VOICEOBS_LOG_LEVEL=INFO
# VOICEOBS_AUDIO_ANALYSIS=1           # global default for the audio overlay (per-agent config overrides)
# VOICEOBS_ALLOW_DELETE=1            # gate for hard call erasure (DELETE /v1/calls/{id})
# VOICEOBS_DEV_AUDIO_DIR=/path/to/wavs   # dev: serve s3://bucket/key from {dir}/key on local disk
# VOICEOBS_BOOTSTRAP_EMAIL=
# VOICEOBS_BOOTSTRAP_ORG=Default
# VOICEOBS_WORKER_POLL_S=5
# VOICEOBS_WORKER_BATCH=10
# VOICEOBS_WORKER_GRACE_S=60
# VOICEOBS_RECONCILE_GRACE_S=600
# VOICEOBS_RECONCILE_INTERVAL_S=300  # unset = one-shot reconcile; set = sidecar loop
# VOICEOBS_ACCESS_TTL_MIN=15
# VOICEOBS_REFRESH_TTL_DAYS=14
# VOICEOBS_INVITE_TTL_DAYS=7

# ── NOT here at runtime (by design) ─────────────────────────────────────────────
# • S3 credentials for audio  → per-agent, encrypted in the DB (agent audio config UI)
# • STT endpoint/model/key    → per-agent, encrypted in the DB (agent audio config)
