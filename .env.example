# Pulse configuration. Copy to `.env` (gitignored) and fill in.
# Everything here is env: secrets + per-deployment knobs. Product behavior (metric
# definitions, model pricing, LLM prompts) lives in committed code, not here.
# All variables are read by voiceobs/settings.py (VOICEOBS_ prefix).

# ── Secrets (required in a real deployment) ─────────────────────────────────────
# Signs session JWTs AND encrypts stored credentials (e.g. per-agent S3 secrets).
# Keep it stable and secret; rotating it logs everyone out and orphans encrypted creds.
VOICEOBS_SECRET_KEY=

# SQLite auto-enables dev mode; use Postgres in production.
VOICEOBS_DATABASE_URL=postgresql://user:pass@localhost:5432/pulse

# ── First-run owner (headless bootstrap: python -m voiceobs.auth bootstrap) ──────
VOICEOBS_BOOTSTRAP_EMAIL=
VOICEOBS_BOOTSTRAP_PASSWORD=
VOICEOBS_BOOTSTRAP_ORG=Default

# ── Deployment knobs ────────────────────────────────────────────────────────────
# Dev conveniences (prefilled login, token-less ingest, secret fallbacks). NEVER in prod.
VOICEOBS_DEV_OPEN=0
VOICEOBS_LOG_LEVEL=INFO
# Global default for the audio overlay; per-agent config overrides this.
VOICEOBS_AUDIO_ANALYSIS=0
# Gate for hard call erasure (DELETE /v1/calls/{id}).
VOICEOBS_ALLOW_DELETE=0

# ── Worker / reconcile (operational, sensible defaults) ─────────────────────────
VOICEOBS_WORKER_POLL_S=5
VOICEOBS_WORKER_BATCH=10
VOICEOBS_WORKER_GRACE_S=60
VOICEOBS_RECONCILE_GRACE_S=600
# Leave unset for a one-shot reconcile; set (seconds) to run it as a sidecar loop.
# VOICEOBS_RECONCILE_INTERVAL_S=300

# ── Auth token lifetimes ────────────────────────────────────────────────────────
VOICEOBS_ACCESS_TTL_MIN=15
VOICEOBS_REFRESH_TTL_DAYS=14
VOICEOBS_INVITE_TTL_DAYS=7

# ── Dev-seed API keys (NOT read by the running app — only by dev scripts that write the
#    per-tenant/agent config into the DB). One endpoint+model+key PER LLM role.
#    In production these live in the DB (LLMConfig per role; STT on the agent audio config). ──
# Post-call-analysis judge (live today):
POST_CALL_BASE_URL=https://api.anthropic.com/v1
POST_CALL_MODEL=claude-haiku-4-5
POST_CALL_API_KEY=
# Global chat (across all calls) — reserved, chat UI not built yet:
GLOBAL_CHAT_BASE_URL=https://api.anthropic.com/v1
GLOBAL_CHAT_MODEL=claude-haiku-4-5
GLOBAL_CHAT_API_KEY=
# Per-call chat (scoped to one call) — reserved:
PER_CALL_CHAT_BASE_URL=https://api.anthropic.com/v1
PER_CALL_CHAT_MODEL=claude-haiku-4-5
PER_CALL_CHAT_API_KEY=
# BYO STT for transcript verification (OpenAI-compatible /audio/transcriptions; Anthropic has no STT):
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe
STT_API_KEY=

# ── NOT here at runtime (by design) ─────────────────────────────────────────────
# • S3 credentials for audio  → per-agent, encrypted in the DB (agent audio config UI)
# • LLM endpoint/model/key    → per-tenant, in the DB (LLMConfig, per role)
# • STT endpoint/model/key    → per-agent, encrypted in the DB (agent audio config)
