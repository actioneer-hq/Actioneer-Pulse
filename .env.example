# Pulse environment. Copy to `.env` (gitignored) and fill in.
#
# THIS FILE HOLDS SECRETS ONLY — API keys, DB URL, signing key, bootstrap password.
# Everything else (dev knobs, worker/reconcile, token lifetimes, and the per-role LLM
# provider + model) lives in src/voiceobs/config.py — edit there, not here.
# All variables are VOICEOBS_-prefixed and read by voiceobs/config.py.

# ── Core secrets (required in a real deployment) ────────────────────────────────
# Signs session JWTs AND encrypts stored credentials (e.g. per-agent S3 secrets).
# Keep it stable and secret; rotating it logs everyone out and orphans encrypted creds.
VOICEOBS_SECRET_KEY=

# SQLite auto-enables dev mode; use Postgres in production.
VOICEOBS_DATABASE_URL=postgresql://user:pass@localhost:5432/pulse

# ── First-run owner (headless bootstrap: python -m voiceobs.auth bootstrap) ──────
VOICEOBS_BOOTSTRAP_PASSWORD=

# ── LLM API keys (one per role; provider + model are set in config.py) ───────────
# A role is active only when its key is set. Roles sharing a provider may reuse the
# same key value. Leave a role's key blank to disable it (judge skips / chat errors).
VOICEOBS_POST_CALL_API_KEY=
VOICEOBS_GLOBAL_CHAT_API_KEY=
VOICEOBS_PER_CALL_CHAT_API_KEY=
# Failure-analysis LLM — runs alongside the judge for root-cause analysis (leave blank to skip).
VOICEOBS_FAILURE_ANALYSIS_API_KEY=
# BYO embedding model for clustering unscripted moments (OpenAI-compatible endpoint). Default model is
# Qwen3-Embedding-0.6B with a task instruct (config.py: embedding_model / embedding_instruct). Local dev:
# `uv run --with sentence-transformers --with fastapi --with uvicorn python scripts/local_embeddings.py`
# then VOICEOBS_EMBEDDING_BASE_URL=http://host.docker.internal:8765/v1. Leave blank to skip clustering.
VOICEOBS_EMBEDDING_API_KEY=

# ── Optional overrides (defaults live in config.py; set here only to override) ───
# VOICEOBS_DEV_OPEN=1                 # dev conveniences (prefilled login, token-less ingest). NEVER in prod.
# VOICEOBS_LOG_LEVEL=INFO
# VOICEOBS_AUDIO_ANALYSIS=1           # global default for the audio overlay (per-agent config overrides)
# VOICEOBS_ALLOW_DELETE=1            # gate for hard call erasure (DELETE /v1/calls/{id})
# VOICEOBS_DEV_AUDIO_DIR=/path/to/wavs   # dev: serve s3://bucket/key from {dir}/key on local disk

# File onboarding: Sarvam STT transcribes uploaded call audio when no transcript JSON is given.
# VOICEOBS_SARVAM_API_KEY=
# VOICEOBS_SARVAM_STT_MODEL=saarika:v2.5
# VOICEOBS_UPLOAD_DIR=./data/uploads   # where uploaded audio is stored (compose: a shared volume)

# Journey judge: a decision model (yes/no / choice / score answers) judges every call against the
# script's journey (stage 1, seconds); the journey-llm worker then adds summary, timeline and failure
# spans (stage 2) and training data from failed turns (stage 3). Unset = the classic judge runs instead.
# VOICEOBS_DECISION_API_KEY=          # OpenAI key for the Decisions API (gpt-6-luna)
# VOICEOBS_DECISION_MODEL=gpt-6-luna
# VOICEOBS_JOURNEY_JUDGE_API_KEY=     # stage 2; unset -> uses VOICEOBS_POST_CALL_API_KEY
# VOICEOBS_TRAINING_CURATOR_API_KEY=  # stage 3; unset -> uses VOICEOBS_POST_CALL_API_KEY
# VOICEOBS_CURATE_ENABLED=true        # stage 3 on/off
# VOICEOBS_SCRIPT_JOURNEY_API_KEY=    # script -> journey extraction; unset -> VOICEOBS_POST_CALL_API_KEY
# VOICEOBS_BOOTSTRAP_EMAIL=
# VOICEOBS_BOOTSTRAP_ORG=Default
# VOICEOBS_WORKER_POLL_S=5
# VOICEOBS_WORKER_BATCH=10
# VOICEOBS_WORKER_GRACE_S=60
# VOICEOBS_RECONCILE_GRACE_S=600
# VOICEOBS_RECONCILE_INTERVAL_S=300  # unset = one-shot reconcile; set = sidecar loop
# VOICEOBS_ACCESS_TTL_MIN=15
# VOICEOBS_REFRESH_TTL_DAYS=14
# VOICEOBS_INVITE_TTL_DAYS=7

# ── Security hardening (safe defaults; override only if you understand the tradeoff) ─
# Ingest body / decompression caps — reject oversized bodies and gzip bombs.
# VOICEOBS_MAX_INGEST_BYTES=33554432       # 32 MiB max request body (also honored by the Go ingest)
# VOICEOBS_MAX_DECODED_BYTES=268435456     # 256 MiB max gunzip output
# SSRF guard: block tenant storage endpoints that resolve to internal/loopback/metadata IPs.
# Default ON (multi-tenant-safe). Set 0 ONLY on a single-tenant self-host whose storage is internal
# (e.g. a MinIO on localhost / a private VPC endpoint).
# VOICEOBS_BLOCK_INTERNAL_FETCH=0
# Chat SQL agent read-only role (REQUIRED on Postgres — the agent runs LLM-generated SQL and must
# never use the main read-write connection). Point at a dedicated pulse_agent_ro role.
# VOICEOBS_AGENT_DATABASE_URL=postgresql+psycopg://pulse_agent_ro:...@host:5432/voiceobs

# ── NOT here at runtime (by design) ─────────────────────────────────────────────
# • S3 credentials for audio  → per-agent, encrypted in the DB (agent audio config UI)
# • STT endpoint/model/key    → per-agent, encrypted in the DB (agent audio config)

# Ingest→analysis transport (Kafka/Redpanda). Required in prod; tests use an in-memory double.
VOICEOBS_KAFKA_BROKERS=localhost:9092

# Auth abuse protection (optional; unset = disabled, dev-open bypasses it anyway).
VOICEOBS_REDIS_URL=redis://localhost:6379

# Optional: BYO audio-native LLM for the chat agents' audio_native_llm tool (analyzes call audio —
# tone, emotion, noise, quality). Enabled only when the key is set. Point at any OpenAI-compatible
# audio-in endpoint (GPT-4o-audio, or a server fronting Qwen2.5-Omni / Kimi-Audio).
# VOICEOBS_AUDIO_NATIVE_API_KEY=sk-...
# VOICEOBS_AUDIO_NATIVE_PROVIDER=openai
# VOICEOBS_AUDIO_NATIVE_MODEL=gpt-4o-audio-preview
# VOICEOBS_AUDIO_NATIVE_BASE_URL=

# Anonymous usage telemetry — aggregate product signals only, never tenant data. Inert until an
# endpoint is set. Opt out with VOICEOBS_TELEMETRY_DISABLED=1 or DO_NOT_TRACK=1 (also off in CI).
# VOICEOBS_TELEMETRY_ENDPOINT=https://telemetry.example/ingest
# VOICEOBS_TELEMETRY_DISABLED=1
# VOICEOBS_INSTALL_ID=<set once for stable install counts across restarts>
