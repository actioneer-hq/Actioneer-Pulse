# LiveKit Cloud (from your project settings)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>

# Provider (this starter uses OpenAI for STT + LLM + TTS)
OPENAI_API_KEY=<key>

# Pulse ingest — where the agent's OTLP traces go (Pulse's /v1/traces)
VO_OTLP_ENDPOINT=http://localhost:8000/v1/traces
